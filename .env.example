# Copy this file to .env and replace every placeholder before starting Compose.
# Never commit the resulting .env file.
CORS_ORIGIN=https://app.example.com
JWT_SECRET=replace-with-at-least-32-random-characters
IXC_BASE_URL=https://your-ixc-host.example.com/webservice/v1
IXC_TOKEN=replace-with-a-rotated-ixc-token
PIX_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
AI_PROVIDER=hybrid
GEMINI_API_KEY=
