{
  "expo": {
    "name": "DBS Telecom",
    "slug": "dbs",
    "scheme": "dbs",
    "owner": "jpclow-dev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dbstelecom.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.dbstelecom.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir que o DBS Telecom use o microfone para enviar mensagens de áudio ao atendimento.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o DBS Telecom use o Face ID para proteger o acesso à sua conta."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dd7e3858-ea73-465c-87c7-dc30873d494d"
      }
    }
  }
}
