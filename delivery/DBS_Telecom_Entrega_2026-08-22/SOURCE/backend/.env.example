# ============================================================
# Backend DBS Telecom — variáveis de ambiente (exemplo)
# Copie para .env e ajuste os valores:  cp .env.example .env
# ============================================================

# Servidor HTTP & Ambiente
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081
DBS_DEMO_MODE=false
# DEMO_MODE=true é um alias aceito além de DBS_DEMO_MODE (apenas fora de produção).
DEMO_MODE=false

# ------------------------------------------------------------
# Banco de dados (PostgreSQL gerenciado no Neon)
# ------------------------------------------------------------
# String de conexão no formato:
#   postgresql://USUARIO:SENHA@ep-xxxx-xxxx.sa-east-1.aws.neon.tech/NEONDB?sslmode=require
# - Obtenha-a no painel do Neon (Dashboard → Connection Details) ou via CLI.
# - Mantenha sempre sslmode=require (ou channel_binding=require) — o Neon exige TLS.
# - Usada pelo backend em runtime, pelos testes de contrato (vitest.live) e
#   pelo runner de migrações (`npm run migrate`).
# - DEIXE VAZIA para rodar em modo demo local: sem DATABASE_URL o backend usa
#   SQLite em memória (dados não persistem e são perdidos ao reiniciar).
DATABASE_URL=

# Segurança & Autenticação JWT Anti-IDOR
# Em produção exige no mínimo 32 caracteres aleatórios (ex.: `openssl rand -base64 48`).
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Integração WebService v1 do ERP IXC Soft
IXC_BASE_URL=https://your-ixc-host.example.com/webservice/v1
IXC_TOKEN=replace-with-a-rotated-ixc-token

# Assinatura HMAC dos webhooks PIX (mínimo 32 caracteres em produção)
PIX_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Orquestrador de Inteligência Artificial DBS Telecom
# Provedores: gemini | openai | hybrid | mock (use "mock" em desenvolvimento/E2E)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.2
AI_GUARDRAILS_ENABLED=true

# Provedores Secundários (Opcional)
OPENAI_API_KEY=
