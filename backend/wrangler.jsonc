{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dbs-telecom-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "NODE_ENV": "production",
    "AI_PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-3.6-flash"
  },
  "observability": {
    "enabled": true
  }
}
