{
  "name": "dbs-telecom-backend",
  "version": "1.0.0",
  "description": "BFF e API de Atendimento Inteligente DBS Telecom com Integração IXC Soft e IA",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:types": "wrangler types",
    "migrate": "node scripts/run-migrations.mjs",
    "migrate:sqlite-to-neon": "node scripts/migrate-sqlite-to-neon.mjs",
    "postinstall": "patch-package",
    "test": "vitest run --config vitest.config.mts",
    "test:live-contracts": "vitest run --config vitest.live.config.mts",
    "test:watch": "vitest --config vitest.config.mts"
  },
  "keywords": [
    "dbs-telecom",
    "ixcsoft",
    "ai",
    "chatbot",
    "bff"
  ],
  "author": "DBS Telecom",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@neondatabase/serverless": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "patch-package": "^8.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.8.6",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "^13.0.3",
    "openapi-types": "^12.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
