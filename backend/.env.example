# Servidor HTTP & Ambiente
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Segurança & Autenticação JWT Anti-IDOR
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Persistência do Chat & Histórico (SQLite)
DB_PATH=./data/dbs_telecom.sqlite

# Integração WebService v1 do ERP IXC Soft
IXC_BASE_URL=https://demo.ixcsoft.com.br/webservice/v1
IXC_TOKEN=replace-with-a-rotated-ixc-token

# Orquestrador de Inteligência Artificial DBS Telecom
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_TEMPERATURE=0.2
AI_GUARDRAILS_ENABLED=true

# Provedores Secundários (Opcional)
OPENAI_API_KEY=
